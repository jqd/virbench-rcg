manifest {
    name = 'virbench-rcg'
    description = 'Viral metagenomics taxonomy and benchmarking pipeline using RefSeq-CG'
}

includeConfig 'profiles/schedulers.config'

params {
    samples = "samples.tsv"
    // Use absolute env prefixes so Nextflow reuses existing environments.
    unified_conda_env = System.getenv('VIRBENCH_UNIFIED_CONDA_ENV') ?: "${System.getProperty('user.home')}/.conda/envs/virbench-rcg"
    FVE_dir = System.getenv('VIRBENCH_FVE_DIR') ?: "${System.getProperty('user.home')}/bin/FastViromeExplorer"
    viromescan_conda_env = System.getenv('VIRBENCH_VIROMESCAN_CONDA_ENV') ?: "${System.getProperty('user.home')}/.conda/envs/viromescan"
    host = System.getenv('VIRBENCH_HOST_INDEX') ?: null
    outdir = null
    assembler = 'both'  // Options: 'megahit', 'metaspades', or 'both'
    skip_fastp = false
    skip_remove_host = false
    task.cpus = 5
    blast_evalue = '1e-5'
    blast_number_bitscores = 5

    // Database settings must be set via profile:
    // -profile <executor_profile>,db_default
    // -profile <executor_profile>,db_refseq
    blast_db = null
    kaiju_db = null
    kaiju_tax_path = null
    mmseqs2_db = null

    FVE_db = null
    FVE_vlist = null
    FVE_default_db = null
    FVE_acc2taxon = null

    viromescan_db = null
    viromescan_default_db = null
    viromescan_acc2taxon = null
    // See INSTALLATION.md for ViromeScan and FastViromeExplorer setup notes.

    kraken2_db = null

    // CD-HIT clustering parameters
    cdhit_identity = 0.95
    cdhit_word_length = 10

    // Taxonomy options (use one of these)
    // ncbi_taxonomy_dir: NCBI taxonomy database for taxonkit (default, generates lineage on-the-fly)
    // taxonomy: Pre-computed taxonomy lineage file (alternative)
    ncbi_taxonomy_dir = System.getenv('VIRBENCH_NCBI_TAXONOMY_DIR') ?: null
    taxonomy = ''  // Leave empty to use ncbi_taxonomy_dir

    // Metrics calculation files
    ground_truth = System.getenv('VIRBENCH_GROUND_TRUTH') ?: null

    // Skip metrics calculation (set to true to skip)
    skip_metrics = false
}

report {
    enabled = true
    file = 'report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = 'timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = 'trace.txt'
    overwrite = true
}

process {
    withLabel: 'io_limited' {
        cpus = 4
        memory = 8.GB
        time = 24.h
    }
    withLabel: 'io_limited_local' {
        cpus = 2
        memory = 8.GB
        time = 24.h
    }

    withLabel: 'io_net' {
        cpus = 2
        memory = 8.GB
        time = 24.h
    }

    withLabel: 'io_mem' {
        cpus = 30
        memory = 10.GB
        time = 144.h
    }

    withLabel: 'multithread' {
        cpus = 20
        memory = 10.GB
        time = 72.h
    }
    withLabel: 'mem_medium' {
        cpus = 10
        memory = 8.GB
        time = 72.h
    }
    withLabel: 'mem_veryhigh' {
        cpus = 30
        memory = 10.GB
        time = 72.h
    }
}

profiles {
    db_default {
        params {
            outdir = 'results_default'
            blast_db = System.getenv('VIRBENCH_DEFAULT_BLAST_DB') ?: null
            kaiju_db = System.getenv('VIRBENCH_DEFAULT_KAIJU_DB') ?: null
            kaiju_tax_path = System.getenv('VIRBENCH_DEFAULT_KAIJU_TAX_PATH') ?: null
            mmseqs2_db = System.getenv('VIRBENCH_DEFAULT_MMSEQS2_DB') ?: null
            FVE_db = System.getenv('VIRBENCH_DEFAULT_FVE_DB') ?: null
            FVE_vlist = System.getenv('VIRBENCH_DEFAULT_FVE_VLIST') ?: null
            FVE_default_db = true
            FVE_acc2taxon = System.getenv('VIRBENCH_DEFAULT_FVE_ACC2TAXON') ?: null
            viromescan_db = System.getenv('VIRBENCH_DEFAULT_VIROMESCAN_DB') ?: null
            viromescan_default_db = true
            viromescan_acc2taxon = System.getenv('VIRBENCH_DEFAULT_VIROMESCAN_ACC2TAXON') ?: null
            kraken2_db = System.getenv('VIRBENCH_DEFAULT_KRAKEN2_DB') ?: null
        }

    }

    db_refseq {
        params {
            outdir = 'results_refseq'
            blast_db = System.getenv('VIRBENCH_REFSEQ_BLAST_DB') ?: null
            kaiju_db = System.getenv('VIRBENCH_REFSEQ_KAIJU_DB') ?: null
            kaiju_tax_path = System.getenv('VIRBENCH_REFSEQ_KAIJU_TAX_PATH') ?: null
            mmseqs2_db = System.getenv('VIRBENCH_REFSEQ_MMSEQS2_DB') ?: null
            FVE_db = System.getenv('VIRBENCH_REFSEQ_FVE_DB') ?: null
            FVE_vlist = System.getenv('VIRBENCH_REFSEQ_FVE_VLIST') ?: null
            FVE_default_db = false
            FVE_acc2taxon = ""
            // For custom ViromeScan DB names, ensure the DB exists under:
            // ~/.conda/envs/viromescan/viromescan/database/bowtie2/
            viromescan_db = System.getenv('VIRBENCH_REFSEQ_VIROMESCAN_DB') ?: null
            viromescan_default_db = false
            viromescan_acc2taxon = ""
            kraken2_db = System.getenv('VIRBENCH_REFSEQ_KRAKEN2_DB') ?: null
        }

        // RefSeq config previously used lower io_mem cpu allocation
        process {
            withLabel: 'io_mem' {
                cpus = 12
                memory = 10.GB
                time = 144.h
            }
        }
    }
}

singularity {
    enabled = true
    autoMounts = true
}

conda.enabled = true

// ----------------------
// Manifest
// ----------------------
manifest {
    name            = 'virbench-rcg'
    author          = 'Qidong Jia'
    description     = 'Viral metagenomics taxonomy and benchmarking pipeline using RefSeq-CG'
    nextflowVersion = '!>=23.10.0'
    version         = '1.1.0'
}